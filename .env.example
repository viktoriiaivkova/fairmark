# Local database settings for docker-compose.yml.
# Copy this file to .env (git-ignored) and choose your own password.
# Use letters and digits only, without quotes: Docker Compose treats $ in .env as a variable,
# and ; would break the API connection string.
# The values are applied only when the database is created (empty volume). To change them later,
# run `docker compose down -v` (deletes all data) and start the database again.
# The API connection string in user secrets must use the same values (see README).
POSTGRES_DB=fairmark
POSTGRES_USER=fairmark
POSTGRES_PASSWORD=change-me
